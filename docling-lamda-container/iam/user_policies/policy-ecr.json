{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Effect": "Allow",
			"Action": [
				"ecr:CreateRepository",
				"ecr:DescribeRepositories",
				"ecr:ListImages",
				"ecr:BatchCheckLayerAvailability",
				"ecr:PutImage",
				"ecr:InitiateLayerUpload",
				"ecr:UploadLayerPart",
				"ecr:CompleteLayerUpload",
				"ecr:GetAuthorizationToken"
			],
			"Resource": [
				"arn:aws:ecr:<region>:<account-id>:repository/docling-*"
			]
		},
		    {
        "Effect": "Allow",
        "Action":[
            "ecr:GetAuthorizationToken"
        ],
        "Resource":"*"
    }
	]
}